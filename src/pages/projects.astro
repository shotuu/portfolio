---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const featured = projects.filter(p => p.featured);
const other = projects.filter(p => !p.featured);
---

<BaseLayout title="Projects">
  <section class="section">
    <div class="container">
      <h1>Projects</h1>
      <p class="page-subtitle">The bigger things I've built, then the smaller ones.</p>

      {featured.length > 0 && (
        <div class="project-section">
          <h2 class="project-section__title">Main projects</h2>
          <div class="projects-grid">
            {featured.map(project => (
              <div class="card project-card project-card--featured">
                <h3 class="card__title">{project.title}</h3>
                <p class="card__description">{project.description}</p>
                <div class="card__tags">
                  {project.tags.map(tag => <span class="badge">{tag}</span>)}
                </div>
                <div class="project-card__links">
                  {project.github && (
                    <a href={project.github} class="project-link" target="_blank" rel="noopener">
                      Code &nearr;
                    </a>
                  )}
                  {project.link && project.link !== '#' && (
                    <a href={project.link} class="project-link" target="_blank" rel="noopener">
                      Site &nearr;
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {other.length > 0 && (
        <div class="project-section">
          <h2 class="project-section__title">Smaller things</h2>
          <div class="projects-grid">
            {other.map(project => (
              <div class="card project-card project-card--other">
                <h3 class="card__title">{project.title}</h3>
                <p class="card__description">{project.description}</p>
                <div class="card__tags">
                  {project.tags.map(tag => <span class="badge">{tag}</span>)}
                </div>
                <div class="project-card__links">
                  {project.github && (
                    <a href={project.github} class="project-link" target="_blank" rel="noopener">
                      Code &nearr;
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-subtitle {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-3xl);
    font-size: 1.0625rem;
  }

  .project-section {
    margin-bottom: var(--space-3xl);
  }

  .project-section__title {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .project-section__title::before {
    content: '> ';
    color: var(--accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-card--other {
    background: var(--bg-secondary);
    border-color: var(--border-light);
  }

  .project-card .card__tags {
    margin-top: auto;
  }

  .project-card__links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .project-section__title::before {
    content: '> ';
    color: var(--accent);
  }

  .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
