---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const featuredProjects = projects.filter(p => p.featured);

// Recent blog posts (latest 3)
const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const allPosts = Object.values(postModules) as any[];
const recentPosts = allPosts
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const skills: { label: string; items: string[] }[] = [
  { label: 'Languages', items: ['Python', 'C++', 'JavaScript', 'Swift', 'SQL'] },
  { label: 'Security', items: ['Pen testing', 'Cryptography', 'Wireshark', 'nmap', 'ICS/OT'] },
  { label: 'Frameworks', items: ['React', 'Node.js', 'Flask', 'FastAPI', 'SwiftUI'] },
  { label: 'Tools', items: ['Linux', 'Git', 'Docker', 'Bash'] },
  { label: 'Data & ML', items: ['TensorFlow', 'OpenCV', 'pandas', 'scikit-learn'] },
];
---

<BaseLayout title="Home">
  <section class="hero section">
    <div class="container">
      <div class="hero-top">
        <img src="/daniel_wu.jpg" alt="Daniel Wu" class="hero-photo" width="88" height="88" />
        <div>
          <h1 class="hero-name">Daniel Wu</h1>
          <p class="hero-role">CS @ UCLA, from Singapore</p>
        </div>
      </div>
      <p class="hero-tagline">
        I build things, break things, and write about the bugs that cost me a weekend.
        I dabble with music sometimes.
      </p>
      <div class="hero-cta">
        <a href="/projects" class="btn btn--primary">See my projects</a>
        <a href="/resume" class="btn">Read my resume</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">About</h2>
      <div class="about-content">
        <p>
          I'm a sophomore studying computer science at UCLA. Before college I spent a year and a
          half as a cyber threat intelligence analyst with Singapore's Digital &amp; Intelligence
          Service, which is most of the reason I care about security. Since getting here I've
          helped run the infrastructure for LA CTF and started interning at Scalence Labs.
        </p>
        <p>
          The rest of my time goes into side projects, most of which are on this site. There's
          also a cat in the corner. If you poke around enough you can buy it a hat.
        </p>
      </div>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Projects</h2>
          <a href="/projects" class="section-more">All projects &rarr;</a>
        </div>
        <ul class="row-list">
          {featuredProjects.map(project => (
            <li class="row">
              <div class="row__head">
                <h3 class="row__title">{project.title}</h3>
                <div class="row__links">
                  {project.link && project.link !== '#' && (
                    <a href={project.link} target="_blank" rel="noopener">Site &nearr;</a>
                  )}
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noopener">Code &nearr;</a>
                  )}
                </div>
              </div>
              <p class="row__desc">{project.summary ?? project.description}</p>
              <p class="row__meta">{project.tags.slice(0, 5).join(' · ')}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-heading">Writing</h2>
        <a href="/blog" class="section-more">All posts &rarr;</a>
      </div>

      {recentPosts.length > 0 ? (
        <ul class="row-list">
          {recentPosts.map(post => (
            <li class="row">
              <a href={`/blog/${post.frontmatter.slug}`} class="row__link">
                <time class="row__date" datetime={post.frontmatter.date}>{formatDate(post.frontmatter.date)}</time>
                <h3 class="row__title">{post.frontmatter.title}</h3>
                {post.frontmatter.description && (
                  <p class="row__desc">{post.frontmatter.description}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing here yet.</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">Tools I use</h2>
      <dl class="skills">
        {skills.map(group => (
          <div class="skills__row">
            <dt>{group.label}</dt>
            <dd>{group.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">Music</h2>
      <p class="music-sub">Stuff I've been making on the side, as SYR3N.</p>
      <div class="music-card">
        <iframe
          title="SYR3N on Spotify"
          src="https://open.spotify.com/embed/artist/0sStTpewAdWD6kKrWSFZqX?utm_source=generator&theme=0"
          width="100%"
          height="352"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-line">
        <h2 class="section-heading">Say hi</h2>
        <p>
          Email is the best way to reach me:
          <a href="mailto:wuscdaniel@ucla.edu">wuscdaniel@ucla.edu</a>. I'm also on
          <a href="https://github.com/shotuu" target="_blank" rel="noopener">GitHub</a> and
          <a href="https://linkedin.com/in/wuscdaniel" target="_blank" rel="noopener">LinkedIn</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-top: var(--space-3xl);
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .hero-photo {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .hero-name {
    margin-bottom: var(--space-xs);
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  .hero-tagline {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-primary);
    max-width: 34ch;
    margin-bottom: var(--space-xl);
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Section chrome */
  .section-heading {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .section-heading::before {
    content: '> ';
    color: var(--accent);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .section-more {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .section-more:hover {
    color: var(--text-primary);
  }

  /* About */
  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .about-content p {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* Project + post rows */
  .row-list {
    list-style: none;
    border-top: 1px solid var(--border-light);
  }

  .row {
    border-bottom: 1px solid var(--border-light);
  }

  .row:not(:has(.row__link)) {
    padding: var(--space-lg) 0;
  }

  .row__link {
    display: block;
    padding: var(--space-lg) 0;
    color: inherit;
    text-decoration: none;
  }

  .row__link:hover {
    text-decoration: none;
  }

  .row__link:hover .row__title {
    color: var(--accent);
  }

  .row__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .row__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
    transition: color var(--transition-fast);
  }

  .row__links {
    display: flex;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .row__desc {
    font-size: 0.9375rem;
    margin-bottom: var(--space-xs);
  }

  .row__date,
  .row__meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .row__date {
    margin-bottom: var(--space-xs);
  }

  .empty {
    color: var(--text-tertiary);
  }

  /* Skills */
  .skills__row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border-light);
  }

  .skills__row:first-child {
    border-top: 1px solid var(--border-light);
  }

  .skills dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    padding-top: 0.15em;
  }

  .skills dd {
    color: var(--text-secondary);
  }

  /* Music */
  .music-sub {
    margin-bottom: var(--space-lg);
  }

  .music-card iframe {
    display: block;
    border-radius: 12px;
  }

  @media (max-width: 480px) {
    .hero-photo {
      width: 64px;
      height: 64px;
    }

    .hero-tagline {
      font-size: 1.125rem;
    }

    .skills__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
