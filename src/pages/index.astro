---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const featuredProjects = projects.filter(p => p.featured);

// Recent blog posts (latest 3)
const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const allPosts = Object.values(postModules) as any[];
const recentPosts = allPosts
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Ordered strongest first. Each row lists only tools used in real work. `sources`
// is the "where" behind the row, revealed as a tree when the row is expanded, so every
// line is something I can back up in an interview.
interface SkillSource {
  place: string;
  tools: string;
}

interface SkillGroup {
  label: string;
  /** Directory-style name shown in the tree's `$ tree <dir>/` prompt line. */
  dir: string;
  items: string[];
  sources: SkillSource[];
}

const skills: SkillGroup[] = [
  {
    label: 'Languages',
    dir: 'languages',
    items: ['Python', 'TypeScript', 'JavaScript', 'SQL', 'C++', 'Bash'],
    sources: [
      { place: 'DIS intel pipeline', tools: 'Python' },
      { place: 'Hatch', tools: 'Python, TypeScript' },
      { place: 'Meadow', tools: 'TypeScript, SQL' },
      { place: 'Synth', tools: 'TypeScript' },
      { place: 'Telos', tools: 'JavaScript, SQL' },
      { place: 'UCLA coursework', tools: 'C++, Bash' },
    ],
  },
  {
    label: 'Web & apps',
    dir: 'web',
    items: ['React', 'Next.js', 'Node.js', 'FastAPI', 'PostgreSQL', 'Prisma'],
    sources: [
      { place: 'Telos', tools: 'React, Node.js, PostgreSQL, Prisma' },
      { place: 'Meadow', tools: 'Next.js, PostgreSQL, Prisma' },
      { place: 'Hatch', tools: 'React, FastAPI' },
    ],
  },
  {
    label: 'Cloud & infra',
    dir: 'infra',
    items: ['GCP', 'Kubernetes', 'Docker', 'GitHub Actions', 'Linux'],
    sources: [
      { place: 'LA CTF', tools: 'GCP, Kubernetes, Docker, GitHub Actions' },
      { place: 'Officer cadet training', tools: 'Linux' },
    ],
  },
  {
    label: 'Security',
    dir: 'security',
    items: ['OSINT', 'MITRE ATT&CK', 'Wireshark', 'nmap', 'Scapy', 'Volatility'],
    sources: [
      { place: 'DIS threat intel', tools: 'OSINT, MITRE ATT&CK' },
      { place: 'Officer cadet training', tools: 'Wireshark, nmap, Scapy, Volatility' },
    ],
  },
  {
    label: 'AI & data',
    dir: 'ai',
    items: ['LLM APIs', 'Whisper', 'OpenCV', 'TensorFlow'],
    sources: [
      { place: 'DIS intel pipeline', tools: 'LLM parsing' },
      { place: 'Telos', tools: 'Claude API' },
      { place: 'Meadow', tools: 'Gemini API' },
      { place: 'Synth', tools: 'Whisper' },
      { place: 'NUS research', tools: 'OpenCV, TensorFlow' },
    ],
  },
];
---

<BaseLayout title="Home">
  <section class="hero section">
    <div class="container">
      <div class="hero-top">
        <img src="/daniel_wu.jpg" alt="Daniel Wu" class="hero-photo" width="88" height="88" />
        <div>
          <h1 class="hero-name">Daniel Wu</h1>
          <p class="hero-role">CS @ UCLA</p>
        </div>
      </div>
      <p class="hero-tagline">
        Most of my time goes into what you'll find here: cybersecurity research, side
        projects, and sometimes a little bit of music.
      </p>
      <div class="hero-cta">
        <a href="/projects" class="btn btn--primary">See my projects</a>
        <a href="/resume" class="btn">Read my resume</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">About</h2>
      <div class="about-content">
        <p>
          I'm a sophomore studying computer science at UCLA. Before college I spent a year and a
          half as a cyber threat intelligence analyst with Singapore's Digital &amp; Intelligence
          Service, which is most of the reason I care about security. Since getting here I've
          helped run the infrastructure for LA CTF and started interning at Scalence Labs.
        </p>
        <p>
          Also, there's a cat in the corner. If you poke around enough you can buy it a hat.
        </p>
      </div>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Projects</h2>
          <a href="/projects" class="section-more">All projects &rarr;</a>
        </div>
        <ul class="row-list">
          {featuredProjects.map(project => (
            <li class="row">
              <div class="row__head">
                <h3 class="row__title">{project.title}</h3>
                <div class="row__links">
                  {project.link && project.link !== '#' && (
                    <a href={project.link} target="_blank" rel="noopener">Site &nearr;</a>
                  )}
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noopener">Code &nearr;</a>
                  )}
                </div>
              </div>
              <p class="row__desc">{project.summary ?? project.description}</p>
              <p class="row__meta">{project.tags.slice(0, 5).join(' · ')}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-heading">Writing</h2>
        <a href="/blog" class="section-more">All posts &rarr;</a>
      </div>

      {recentPosts.length > 0 ? (
        <ul class="row-list">
          {recentPosts.map(post => (
            <li class="row">
              <a href={`/blog/${post.frontmatter.slug}`} class="row__link">
                <time class="row__date" datetime={post.frontmatter.date}>{formatDate(post.frontmatter.date)}</time>
                <h3 class="row__title">{post.frontmatter.title}</h3>
                {post.frontmatter.description && (
                  <p class="row__desc">{post.frontmatter.description}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing here yet.</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">Skills</h2>
      <div class="skills">
        {skills.map(group => (
          <details class="skills__row">
            <summary class="skills__summary">
              <span class="skills__label">{group.label}</span>
              <span class="skills__items">{group.items.join(', ')}</span>
              <span class="skills__toggle" aria-hidden="true"></span>
            </summary>
            <div class="skills__tree">
              <p class="skills__cmd"><span class="skills__prompt">$</span> tree {group.dir}/</p>
              <ul>
                {group.sources.map((source, i) => (
                  <li>
                    <span class="skills__branch" aria-hidden="true">{i === group.sources.length - 1 ? '└── ' : '├── '}</span>
                    <span class="skills__place">{source.place}</span>
                    <span class="skills__tools">{source.tools}</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">Music</h2>
      <p class="music-sub">Stuff I've been making on the side, as SYR3N.</p>
      <div class="music-card">
        <iframe
          title="SYR3N on Spotify"
          src="https://open.spotify.com/embed/artist/0sStTpewAdWD6kKrWSFZqX?utm_source=generator&theme=0"
          width="100%"
          height="352"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-line">
        <h2 class="section-heading">Say hi</h2>
        <p>
          Email is the best way to reach me:
          <a href="mailto:wuscdaniel@ucla.edu">wuscdaniel@ucla.edu</a>. I'm also on
          <a href="https://github.com/shotuu" target="_blank" rel="noopener">GitHub</a> and
          <a href="https://linkedin.com/in/wuscdaniel" target="_blank" rel="noopener">LinkedIn</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-top: var(--space-3xl);
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .hero-photo {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .hero-name {
    margin-bottom: var(--space-xs);
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  .hero-tagline {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-primary);
    max-width: 34ch;
    margin-bottom: var(--space-xl);
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Section chrome */
  .section-heading {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .section-heading::before {
    content: '> ';
    color: var(--accent);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .section-more {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .section-more:hover {
    color: var(--text-primary);
  }

  /* About */
  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .about-content p {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* Project + post rows */
  .row-list {
    list-style: none;
    border-top: 1px solid var(--border-light);
  }

  .row {
    border-bottom: 1px solid var(--border-light);
  }

  .row:not(:has(.row__link)) {
    padding: var(--space-lg) 0;
  }

  .row__link {
    display: block;
    padding: var(--space-lg) 0;
    color: inherit;
    text-decoration: none;
  }

  .row__link:hover {
    text-decoration: none;
  }

  .row__link:hover .row__title {
    color: var(--accent);
  }

  .row__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .row__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
    transition: color var(--transition-fast);
  }

  .row__links {
    display: flex;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .row__desc {
    font-size: 0.9375rem;
    margin-bottom: var(--space-xs);
  }

  .row__date,
  .row__meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .row__date {
    margin-bottom: var(--space-xs);
  }

  .empty {
    color: var(--text-tertiary);
  }

  /* Skills: each row expands into a `tree`-style list of where the skills came from */
  .skills__row {
    border-bottom: 1px solid var(--border-light);
  }

  .skills__row:first-child {
    border-top: 1px solid var(--border-light);
  }

  .skills__summary {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-md) 0;
    cursor: pointer;
    list-style: none;
  }

  .skills__summary::-webkit-details-marker {
    display: none;
  }

  .skills__label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .skills__items {
    color: var(--text-primary);
  }

  .skills__toggle {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    transition: color var(--transition-fast);
  }

  .skills__toggle::before {
    content: '[+]';
  }

  .skills__row[open] .skills__toggle::before {
    content: '[-]';
  }

  .skills__summary:hover .skills__toggle,
  .skills__row[open] .skills__toggle {
    color: var(--accent);
  }

  .skills__tree {
    margin: 0 0 var(--space-md) calc(9rem + var(--space-md));
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  .skills__cmd {
    color: var(--text-tertiary);
    max-width: none;
  }

  .skills__prompt {
    color: var(--accent);
  }

  .skills__tree ul {
    list-style: none;
  }

  .skills__tree li {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75ch;
  }

  .skills__branch {
    color: var(--text-tertiary);
    white-space: pre;
  }

  .skills__place {
    color: var(--text-primary);
    /* Wide enough for the longest place name, so the tools line up in a column like real tree output */
    min-width: 23ch;
  }

  .skills__tools {
    color: var(--text-tertiary);
  }

  /* Music */
  .music-sub {
    margin-bottom: var(--space-lg);
  }

  .music-card iframe {
    display: block;
    border-radius: 12px;
  }

  @media (max-width: 480px) {
    .hero-photo {
      width: 64px;
      height: 64px;
    }

    .hero-tagline {
      font-size: 1.125rem;
    }

    .skills__summary {
      grid-template-columns: 1fr auto;
      row-gap: var(--space-xs);
    }

    .skills__label {
      grid-column: 1 / -1;
    }

    .skills__tree {
      margin-left: 0;
    }

    .skills__place {
      min-width: 0;
    }
  }
</style>
