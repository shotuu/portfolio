---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Get all blog posts
const postModules = import.meta.glob('../../content/blog/*.md', { eager: true });
const allPosts = Object.values(postModules) as any[];
const posts = allPosts
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout title="Blog">
  <section class="section">
    <div class="container">
      <h1>Blog</h1>
      <p class="page-subtitle">
        Write-ups of bugs, projects, and whatever I'm figuring out at the moment.
      </p>

      {posts.length === 0 ? (
        <div class="empty-state">
          <p class="empty-state__text">Nothing here yet.</p>
        </div>
      ) : (
        <div class="posts-list">
          {posts.map(post => (
            <a href={`/blog/${post.frontmatter.slug}`} class="post-item">
              <div class="post-item__meta">
                <time datetime={post.frontmatter.date}>
                  {new Date(post.frontmatter.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h3 class="post-item__title">{post.frontmatter.title}</h3>
              {post.frontmatter.description && (
                <p class="post-item__desc">{post.frontmatter.description}</p>
              )}
              {post.frontmatter.tags && (
                <div class="card__tags">
                  {post.frontmatter.tags.map((tag: string) => (
                    <span class="badge">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-subtitle {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-2xl);
    font-size: 1.0625rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-light);
  }

  .post-item {
    display: block;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border-light);
    color: inherit;
    text-decoration: none;
  }

  .post-item:hover {
    text-decoration: none;
  }

  .post-item__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-xs);
  }

  .post-item__title {
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
    transition: color var(--transition-fast);
  }

  .post-item:hover .post-item__title {
    color: var(--accent);
  }

  .post-item__desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
  }

  .empty-state__text {
    color: var(--text-tertiary);
  }
</style>
