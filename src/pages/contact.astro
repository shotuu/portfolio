---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  { label: 'Email', value: 'wuscdaniel@ucla.edu', href: 'mailto:wuscdaniel@ucla.edu', external: false },
  { label: 'GitHub', value: '@shotuu', href: 'https://github.com/shotuu', external: true },
  { label: 'LinkedIn', value: '/in/wuscdaniel', href: 'https://linkedin.com/in/wuscdaniel', external: true },
];
---

<BaseLayout title="Contact">
  <section class="section">
    <div class="container">
      <h1>Contact</h1>
      <p class="page-subtitle">
        Email is the fastest way to reach me. Internships, projects, questions about a post, all fair game.
      </p>

      <ul class="contact-list">
        {contacts.map(contact => (
          <li>
            <a
              href={contact.href}
              class="contact-row"
              {...(contact.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="contact-row__label">{contact.label}</span>
              <span class="contact-row__value">{contact.value}</span>
              <span class="contact-row__arrow" aria-hidden="true">{contact.external ? '↗' : '→'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-subtitle {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-2xl);
    font-size: 1.0625rem;
  }

  .contact-list {
    list-style: none;
    border-top: 1px solid var(--border-light);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border-light);
    color: var(--text-primary);
    text-decoration: none;
  }

  .contact-row:hover {
    text-decoration: none;
  }

  .contact-row__label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .contact-row__value {
    font-size: 1.0625rem;
    transition: color var(--transition-fast);
  }

  .contact-row__arrow {
    color: var(--text-tertiary);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .contact-row:hover .contact-row__value,
  .contact-row:hover .contact-row__arrow {
    color: var(--accent);
  }

  .contact-row:hover .contact-row__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 480px) {
    .contact-row {
      grid-template-columns: 5rem 1fr auto;
    }
  }
</style>
